<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.principiabi.admissions-funnel" extension-version="2.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Vertical stepped admissions funnel with traffic-light coloring for admissions pipeline</description>
    <author name="PrincipiaBI" email="kevin.capp@principia.edu" organization="Principia" website="https://github.com/PrincipiaBI"/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>https://principiabi.github.io/tableau-viz-extensions/admissions-funnel/index.html</url>
    </source-location>
    <icon/>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
    <encoding id="stage">
      <display-name>Stage</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="level"/>
      <tooltip>Drag the funnel stage field here (e.g. FUNNEL_STAGE)</tooltip>
    </encoding>
    <encoding id="actual">
      <display-name>Actual</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="metric"/>
      <tooltip>Drag the actual count measure here (e.g. ACTUAL_COUNT)</tooltip>
    </encoding>
    <encoding id="goal">
      <display-name>Goal</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="dot"/>
      <tooltip>Drag the goal count measure here (e.g. GOAL_COUNT)</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Admissions Funnel</text>
    </resource>
  </resources>
</manifest>
